rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Therapist private documents secure directory
    match /terapeutas/{therapistUid}/documentos/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == therapistUid 
        || request.auth.token.role == 'administrador'
        || request.auth.token.email == 'essenya222@gmail.com' 
      );
      
      allow write: if request.auth != null && (
        request.auth.uid == therapistUid 
        || request.auth.token.role == 'administrador'
        || request.auth.token.email == 'essenya222@gmail.com' 
      ) && (
        // Max 5MB
        request.resource.size < 5 * 1024 * 1024 &&
        // Only images and PDFs
        request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf'
      );
    }
    
    // Client profile pictures or other assets
    match /clientes/{clientUid}/{allPaths=**} {
      allow read: if request.auth != null; 
      allow write: if request.auth != null && request.auth.uid == clientUid && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Default deny for anything not explicitly matched
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
