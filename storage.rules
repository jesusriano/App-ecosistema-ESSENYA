rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Therapist documents secure directory
    match /terapeutas/{therapistUid}/documentos/{allPaths=**} {
      // Therapists can read/write their own documents; administrators can access everything
      allow read, write: if request.auth != null && (
        request.auth.uid == therapistUid 
        || request.auth.token.role == 'administrador' 
        || request.auth.token.email == 'essenya222@gmail.com' 
        || request.auth.token.admin == true
      );
    }

    // Default fallback rules for other folders during active development
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
