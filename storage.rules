rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAllowedFileType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/pdf');
    }
    
    function isValidSize() {
      return request.resource.size <= 20 * 1024 * 1024; // Hasta 20MB
    }

    // Documentos y expedientes privados de terapeutas
    match /terapeutas/{therapistUid}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == therapistUid 
        || request.auth.token.role == 'administrador'
        || request.auth.token.email == 'essenya222@gmail.com'
      );
      
      allow write: if request.auth != null && (
        request.auth.uid == therapistUid 
        || request.auth.token.role == 'administrador'
        || request.auth.token.email == 'essenya222@gmail.com'
      ) && isValidSize() && isAllowedFileType();
    }

    // Fotos de perfil públicas de terapeutas (visibles en el catálogo de clientes)
    match /terapeutas_publicos/{therapistUid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == therapistUid 
        || request.auth.token.role == 'administrador'
        || request.auth.token.email == 'essenya222@gmail.com'
      ) && isValidSize() && isAllowedFileType();
    }
    
    // Archivos de clientes
    match /clientes/{clientUid}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == clientUid 
        || request.auth.token.role == 'administrador'
        || request.auth.token.email == 'essenya222@gmail.com'
      ); 
      allow write: if request.auth != null && (
        request.auth.uid == clientUid
        || request.auth.token.email == 'essenya222@gmail.com'
      ) && isValidSize() && isAllowedFileType();
    }

    // Todo lo demás denegado por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
