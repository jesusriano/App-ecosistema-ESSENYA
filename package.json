{
  "name": "essenya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec \"node test-rules.js\" --only firestore",
    "test:api": "tsx tests/api.test.js",
    "test:security": "npm audit --omit=dev",
    "verify:production": "npm ci && npm run typecheck && npm run test:rules && npm run test:api && npm run test:fraud && npm run test:security && npm run build",
    "test:fraud": "firebase emulators:exec \"tsx tests/fraud.test.ts\" --only firestore"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@google/genai": "^2.4.0",
    "@stripe/stripe-js": "^9.17.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qs": "^6.15.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.10.1",
    "stripe": "^22.6.2",
    "vite": "^6.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "firebase-tools": "^15.30.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "qs": "^6.15.4",
    "jose": "4.15.9",
    "uuid": "^11.1.1"
  }
}
