rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================================
    // 1. GLOBAL HELPERS & PRIMITIVES
    // ========================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        // 1. Cuentas maestras autorizadas explícitamente en el proyecto
        (request.auth.token.keys().hasAny(['email']) && (
          request.auth.token.email.lower() == 'essenya222@gmail.com' ||
          request.auth.token.email.lower() == 'graphixglow.2024@gmail.com'
        )) ||
        // 2. Administrador normal: Requiere SIMULTÁNEAMENTE dominio corporativo + registro activo en administradores
        (
          request.auth.token.keys().hasAny(['email']) && (
            request.auth.token.email.lower().matches('.*@essenya\\.mx$') ||
            request.auth.token.email.lower().matches('.*@essenya\\.com$')
          ) && (
            (
              exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.estado == 'activo'
            ) ||
            (
              exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
              (!get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.keys().hasAny(['estado']) || 
               get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.estado == 'activo')
            )
          )
        )
      );
    }

    // ========================================================
    // 2. VALIDATION HELPERS (Blueprints)
    // ========================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'correo', 'rol', 'estado']) &&
             data.uid == request.auth.uid &&
             data.correo is string && data.correo.size() <= 150 &&
             data.rol is string && data.rol in ['cliente', 'terapeuta', 'administrador'] &&
             data.estado is string && data.estado in ['activo', 'pendiente', 'bloqueado'] &&
             data.keys().size() <= 15;
    }

    function isValidClient(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'membershipTier']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 150 &&
             data.membershipTier is string && data.membershipTier in ['Platino', 'Gold', 'Diamond', 'Black Diamond', 'Imperial VIP'] &&
             (!data.keys().hasAny(['photo', 'fotografia']) || data.get('photo', data.get('fotografia', '')) is string) &&
             data.keys().size() <= 40;
    }

    function isValidSensitiveInfo(data) {
      return (data.keys().hasAny(['curp']) ? (data.curp == null || (data.curp is string && (data.curp == '' || data.curp.matches('^[A-Z0-9]{18}$')))) : true) &&
             (data.keys().hasAny(['cuentaBancariaCLABE']) ? (data.cuentaBancariaCLABE == null || (data.cuentaBancariaCLABE is string && (data.cuentaBancariaCLABE == '' || data.cuentaBancariaCLABE.matches('^[0-9]{18}$')))) : true) &&
             (data.keys().hasAny(['ineNumber']) ? (data.ineNumber == null || (data.ineNumber is string && data.ineNumber.size() <= 25)) : true);
    }

    function isValidTherapist(data) {
      return (data.keys().hasAll(['id']) || data.keys().hasAll(['uid'])) &&
             (data.keys().hasAny(['nombre', 'name']) ? (
               (!data.keys().hasAny(['nombre']) || (data.nombre is string && data.nombre.size() <= 200)) &&
               (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 200))
             ) : false) &&
             (data.keys().hasAny(['correo', 'email']) ? (
               (!data.keys().hasAny(['correo']) || (data.correo is string && data.correo.size() <= 150)) &&
               (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 150))
             ) : false) &&
             (data.keys().hasAny(['estado', 'status']) ? (
               (!data.keys().hasAny(['estado']) || (data.estado is string && data.estado in ['pendiente', 'activo', 'inactivo', 'bloqueado', 'rechazado', 'disponible', 'en_servicio', 'en_camino', 'desconectado'])) &&
               (!data.keys().hasAny(['status']) || (data.status is string && data.status in ['pendiente', 'activo', 'inactivo', 'bloqueado', 'rechazado', 'disponible', 'en_servicio', 'en_camino', 'desconectado']))
             ) : true) &&
             data.keys().size() <= 100;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'clientId', 'serviceId', 'state', 'total', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.clientId is string && data.clientId.size() <= 128 &&
             data.serviceId is string && data.serviceId.size() <= 128 &&
             data.state is string && data.state in ['pendiente', 'aceptada', 'rechazada', 'en_camino', 'llegue', 'servicio_iniciado', 'servicio_finalizado', 'cancelado'] &&
             data.total is number && data.total >= 0 &&
             data.keys().size() <= 60;
    }

    function isValidPanicAlert(data) {
      return data.keys().hasAll(['id', 'userName', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userName is string && data.userName.size() <= 200 &&
             data.status is string && data.status in ['activa', 'en_atencion', 'resuelta'] &&
             (!data.keys().hasAny(['userId']) || data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
             data.keys().size() <= 35;
    }

    function isValidStateTransition(current, next) {
      return (current == 'pendiente' && next in ['aceptada', 'rechazada', 'cancelado']) ||
             (current == 'aceptada' && next in ['en_camino', 'cancelado']) ||
             (current == 'en_camino' && next in ['llegue', 'cancelado']) ||
             (current == 'llegue' && next in ['servicio_iniciado', 'cancelado']) ||
             (current == 'servicio_iniciado' && next == 'servicio_finalizado') ||
             (current == next);
    }

    function isTerminalState(state) {
      return state in ['servicio_finalizado', 'cancelado', 'rechazada'];
    }

    // ========================================================
    // 3. GLOBAL SAFETY NET
    // ========================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================
    // 4. PUBLIC CATALOGS (Read: Public, Write: Admin)
    // ========================================================
    
        match /gift_cards/{cardId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /servicios/{servicioId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /zonas/{zonaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /terapeutas_publicos/{terapeutaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================
    // 5. USER & PROFILE DATA (Owner or Admin)
    // ========================================================
    
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin(); 
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && (
        incoming().rol in ['cliente', 'terapeuta'] 
      );
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && (
        (isOwner(userId) && incoming().rol == existing().rol && 
         incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'apellidos', 'telefono', 'ultimoAcceso', 'fechaActualizacion', 'mustChangePassword', 'photo', 'fotografia'])) ||
        isAdmin()
      );
    }
    
    match /clientes/{clienteId} {
      allow get: if (isOwner(clienteId) || isAdmin()) && isValidId(clienteId);
      allow list: if isAdmin();
      allow create: if isOwner(clienteId) && isValidId(clienteId);
      allow update: if (isOwner(clienteId) || isAdmin()) && isValidId(clienteId);
      allow delete: if isAdmin();

      match /billetera/{cardId} {
        allow get: if (isOwner(clienteId) || isAdmin()) && isValidId(cardId);
        allow list: if isOwner(clienteId) || isAdmin();
        allow write: if isOwner(clienteId) || isAdmin();
      }

      match /wallet_ledger/{ledgerId} {
        allow get: if (isOwner(clienteId) || isAdmin()) && isValidId(ledgerId);
        allow list: if isOwner(clienteId) || isAdmin();
        allow write: if isOwner(clienteId) || isAdmin();
      }
    }
    
    match /terapeutas/{terapeutaId} {
      allow get: if (isOwner(terapeutaId) || isAdmin()) && isValidId(terapeutaId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if (isOwner(terapeutaId) || isAdmin()) && isValidId(terapeutaId) && isValidTherapist(incoming());
      allow update: if (isOwner(terapeutaId) || isAdmin()) && isValidId(terapeutaId);
      allow delete: if isAdmin();

      match /private_info/{docId} {
        allow get: if (isOwner(terapeutaId) || isAdmin()) && isValidId(docId);
        allow list: if isAdmin();
        allow create, update: if (isOwner(terapeutaId) || isAdmin()) && isValidId(docId) && 
                              (docId != 'sensitive' || isValidSensitiveInfo(incoming()));
        allow delete: if isAdmin();
      }
    }

    // ========================================================
    // 6. ADMINISTRATIVE DATA (Admin Only)
    // ========================================================
    
    match /administradores/{adminId} {
      allow get: if (isOwner(adminId) || isAdmin()) && isValidId(adminId);
      allow list: if isAdmin() || (isSignedIn() && (resource.data.correo == request.auth.token.email || resource.data.email == request.auth.token.email));
      allow write: if isAdmin() && isValidId(adminId);
    }
    
    match /admins/{adminId} {
      allow get: if (isOwner(adminId) || isAdmin()) && isValidId(adminId);
      allow list: if isAdmin() || (isSignedIn() && (resource.data.correo == request.auth.token.email || resource.data.email == request.auth.token.email));
      allow write: if isAdmin() && isValidId(adminId);
    }
    
    match /configuraciones/{configId} {
      allow get: if (configId == 'global' || isSignedIn()) && isValidId(configId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if isAdmin();
    }

    match /pwa_diagnostic_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isValidId(logId);
      allow update, delete: if isAdmin();
    }

    // ========================================================
    // 7. BUSINESS OPERATIONS (Bookings, Invoices, Payments)
    // ========================================================
    
    match /reservas/{reservaId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.therapistId == request.auth.uid || 
        (resource.data.keys().hasAny(['therapistId2']) && resource.data.therapistId2 == request.auth.uid) ||
        (resource.data.keys().hasAny(['therapistIds']) && request.auth.uid in resource.data.therapistIds) ||
        resource.data.state in ['pendiente', 'aceptada', 'en_camino', 'llegue', 'servicio_iniciado'] ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /grabaciones_servicio/{recordingId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.therapistId == request.auth.uid ||
        (exists(/databases/$(database)/documents/reservas/$(resource.data.serviceId)) && (
          get(/databases/$(database)/documents/reservas/$(resource.data.serviceId)).data.therapistId == request.auth.uid ||
          (get(/databases/$(database)/documents/reservas/$(resource.data.serviceId)).data.keys().hasAny(['therapistIds']) &&
           request.auth.uid in get(/databases/$(database)/documents/reservas/$(resource.data.serviceId)).data.therapistIds)
        ))
      );
      allow create, update: if isSignedIn() && (
        isAdmin() ||
        incoming().therapistId == request.auth.uid ||
        (exists(/databases/$(database)/documents/reservas/$(incoming().serviceId)) && (
          get(/databases/$(database)/documents/reservas/$(incoming().serviceId)).data.therapistId == request.auth.uid ||
          (get(/databases/$(database)/documents/reservas/$(incoming().serviceId)).data.keys().hasAny(['therapistIds']) &&
           request.auth.uid in get(/databases/$(database)/documents/reservas/$(incoming().serviceId)).data.therapistIds)
        ))
      );
      allow delete: if isAdmin();
    }

    match /conversaciones/{bookingId} {
      allow get: if isSignedIn() && (
        isAdmin() || 
        resource == null ||
        resource.data.clientId == request.auth.uid || 
        resource.data.therapistId == request.auth.uid ||
        (exists(/databases/$(database)/documents/reservas/$(bookingId)) && (
          get(/databases/$(database)/documents/reservas/$(bookingId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/reservas/$(bookingId)).data.therapistId == request.auth.uid
        ))
      );
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.clientId == request.auth.uid || 
        resource.data.therapistId == request.auth.uid
      );
      allow create, update: if isSignedIn() && (
        isAdmin() || 
        incoming().clientId == request.auth.uid || 
        incoming().therapistId == request.auth.uid ||
        (exists(/databases/$(database)/documents/reservas/$(bookingId)) && (
          get(/databases/$(database)/documents/reservas/$(bookingId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/reservas/$(bookingId)).data.therapistId == request.auth.uid
        ))
      );
      allow delete: if isAdmin();

      match /mensajes/{mensajeId} {
        allow get, list: if isSignedIn() && (
          isAdmin() || 
          (exists(/databases/$(database)/documents/conversaciones/$(bookingId)) && (
            get(/databases/$(database)/documents/conversaciones/$(bookingId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/conversaciones/$(bookingId)).data.therapistId == request.auth.uid
          )) ||
          (exists(/databases/$(database)/documents/reservas/$(bookingId)) && (
            get(/databases/$(database)/documents/reservas/$(bookingId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/reservas/$(bookingId)).data.therapistId == request.auth.uid
          ))
        );
        allow create: if isSignedIn() && (
          isAdmin() || 
          incoming().senderId == request.auth.uid ||
          (exists(/databases/$(database)/documents/conversaciones/$(bookingId)) && (
            get(/databases/$(database)/documents/conversaciones/$(bookingId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/conversaciones/$(bookingId)).data.therapistId == request.auth.uid
          )) ||
          (exists(/databases/$(database)/documents/reservas/$(bookingId)) && (
            get(/databases/$(database)/documents/reservas/$(bookingId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/reservas/$(bookingId)).data.therapistId == request.auth.uid
          ))
        );
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
      }
    }
    
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && isValidId(invoiceId) && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(invoiceId) && (isAdmin() || incoming().clientId == request.auth.uid);
      allow update: if isSignedIn() && isValidId(invoiceId) && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /pagos/{pagoId} {
      allow get: if isSignedIn() && isValidId(pagoId) && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(pagoId) && (isAdmin() || incoming().clientId == request.auth.uid);
      allow update: if isSignedIn() && isValidId(pagoId) && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /alertas_panico/{alertaId} {
      allow get: if isSignedIn() && isValidId(alertaId) && (
        resource.data.userId == request.auth.uid || 
        resource.data.usuarioId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.usuarioId == request.auth.uid
      );
      allow create: if isValidId(alertaId) && isValidPanicAlert(incoming());
      allow update: if isValidId(alertaId) && (
        isAdmin() ||
        (isSignedIn() && (resource.data.userId == request.auth.uid || isOwner(resource.data.userId))) ||
        // Action: Live Telemetry update (GPS ping stream from client device)
        incoming().diff(existing()).affectedKeys().hasOnly(['latitude', 'longitude', 'accuracy', 'speed', 'altitude', 'lastTelemetryPing', 'updatedAt', 'userLocation', 'serverTime']) ||
        // Action: Emergency status resolution or escalation
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt', 'attendedBy', 'attendedAt', 'updatedAt', 'notes']) &&
         incoming().status in ['activa', 'en_atencion', 'resuelta'])
      );
      allow delete: if isAdmin();
    }

    match /gastos/{gastoId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
