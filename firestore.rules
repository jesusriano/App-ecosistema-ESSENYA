rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================================
    // 1. GLOBAL HELPERS & PRIMITIVES
    // ========================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'essenya222@gmail.com'
      );
    }

    // ========================================================
    // 2. VALIDATION HELPERS (Blueprints)
    // ========================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'correo', 'rol', 'estado']) &&
             data.uid == request.auth.uid &&
             data.correo is string && data.correo.size() <= 150 &&
             data.rol is string && data.rol in ['cliente', 'terapeuta', 'administrador'] &&
             data.estado is string && data.estado in ['activo', 'pendiente', 'bloqueado'] &&
             data.keys().size() <= 15;
    }

    function isValidClient(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'membershipTier']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 150 &&
             data.membershipTier is string && data.membershipTier in ['Platino', 'Gold', 'Diamond', 'Black Diamond', 'Imperial VIP'] &&
             data.keys().size() <= 25;
    }

    function isValidSensitiveInfo(data) {
      return (data.keys().hasAny(['curp']) ? (data.curp == null || (data.curp is string && data.curp.matches('^[A-Z]{4}[0-9]{6}[A-Z]{6}[0-9A-Z]{2}$'))) : true) &&
             (data.keys().hasAny(['cuentaBancariaCLABE']) ? (data.cuentaBancariaCLABE == null || (data.cuentaBancariaCLABE is string && data.cuentaBancariaCLABE.matches('^[0-9]{18}$'))) : true) &&
             (data.keys().hasAny(['ineNumber']) ? (data.ineNumber == null || (data.ineNumber is string && data.ineNumber.size() <= 20)) : true);
    }

    function isValidTherapist(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 150 &&
             data.status is string && data.status in ['disponible', 'en_servicio', 'en_camino', 'desconectado'] &&
             data.keys().size() <= 30;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'clientId', 'serviceId', 'state', 'total', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.clientId is string && data.clientId.size() <= 128 &&
             data.serviceId is string && data.serviceId.size() <= 128 &&
             data.state is string && data.state in ['pendiente', 'aceptada', 'rechazada', 'en_camino', 'llegue', 'servicio_iniciado', 'servicio_finalizado', 'cancelado'] &&
             data.total is number && data.total >= 0 &&
             data.keys().size() <= 60;
    }

    function isValidPanicAlert(data) {
      return data.keys().hasAll(['id', 'userName', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.status is string && data.status in ['activa', 'en_atencion', 'resuelta'] &&
             data.keys().size() <= 30;
    }

    function isValidStateTransition(current, next) {
      return (current == 'pendiente' && next in ['aceptada', 'rechazada', 'cancelado']) ||
             (current == 'aceptada' && next in ['en_camino', 'cancelado']) ||
             (current == 'en_camino' && next in ['llegue', 'cancelado']) ||
             (current == 'llegue' && next in ['servicio_iniciado', 'cancelado']) ||
             (current == 'servicio_iniciado' && next == 'servicio_finalizado') ||
             (current == next);
    }

    function isTerminalState(state) {
      return state in ['servicio_finalizado', 'cancelado', 'rechazada'];
    }

    // ========================================================
    // 3. GLOBAL SAFETY NET
    // ========================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================
    // 4. PUBLIC CATALOGS (Read: Public, Write: Admin)
    // ========================================================
    
    match /servicios/{servicioId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /zonas/{zonaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /terapeutas_publicos/{terapeutaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================
    // 5. USER & PROFILE DATA (Owner or Admin)
    // ========================================================
    
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin(); 
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && (
        incoming().rol in ['cliente', 'terapeuta'] 
      );
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && (
        (isOwner(userId) && incoming().rol == existing().rol && 
         incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'apellidos', 'telefono', 'ultimoAcceso', 'fechaActualizacion', 'mustChangePassword'])) ||
        isAdmin()
      );
    }
    
    match /clientes/{clienteId} {
      allow get: if (isOwner(clienteId) || isAdmin()) && isValidId(clienteId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if isOwner(clienteId) && isValidId(clienteId) && isValidClient(incoming());
      allow update: if (isOwner(clienteId) || isAdmin()) && isValidId(clienteId) && (
        (isOwner(clienteId) && incoming().membershipTier == existing().membershipTier && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'cityZone', 'photo', 'vipPreferences', 'registeredAddresses'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /billetera/{cardId} {
        allow read, write: if (isOwner(clienteId) || isAdmin()) && isValidId(cardId);
      }
    }
    
    match /terapeutas/{terapeutaId} {
      allow get: if (isOwner(terapeutaId) || isAdmin()) && isValidId(terapeutaId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if isOwner(terapeutaId) && isValidId(terapeutaId) && isValidTherapist(incoming());
      allow update: if (isOwner(terapeutaId) || isAdmin()) && isValidId(terapeutaId) && (
        (isOwner(terapeutaId) && incoming().status == existing().status && 
         incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'photo', 'bio', 'certifications', 'specialties', 'coverageZones', 'lat', 'lng'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /private_info/{docId} {
        allow get: if (isOwner(terapeutaId) || isAdmin()) && isValidId(docId);
        allow list: if isAdmin();
        allow create, update: if (isOwner(terapeutaId) || isAdmin()) && isValidId(docId) && 
                              (docId != 'sensitive' || isValidSensitiveInfo(incoming()));
        allow delete: if isAdmin();
      }
    }

    // ========================================================
    // 6. ADMINISTRATIVE DATA (Admin Only)
    // ========================================================
    
    match /administradores/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }
    
    match /admins/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }
    
    match /configuraciones/{configId} {
      allow read: if (configId == 'global' || isSignedIn()) && isValidId(configId);
      allow write: if isAdmin();
    }
    
    match /settings/{settingId} {
      allow read: if isSignedIn() && isValidId(settingId);
      allow write: if isAdmin();
    }
    
    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if isAdmin();
    }

    // ========================================================
    // 7. BUSINESS OPERATIONS (Bookings, Invoices, Payments)
    // ========================================================
    
    match /reservas/{reservaId} {
      allow get: if isSignedIn() && isValidId(reservaId) && (
        resource.data.clientId == request.auth.uid || 
        resource.data.therapistId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.therapistId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(reservaId) && isValidBooking(incoming()) && (
        incoming().clientId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && isValidId(reservaId) && isValidBooking(incoming()) && (
        isAdmin() ||
        (!isTerminalState(existing().state) && (
          // Action: Client Update (Rating/Comment or cancel)
          (isOwner(existing().clientId) && incoming().total == existing().total && 
           incoming().diff(existing()).affectedKeys().hasOnly(['state', 'rating', 'reviewComment', 'reviewComment', 'reviewedAt', 'updatedAt']) &&
           isValidStateTransition(existing().state, incoming().state)) ||
          // Action: Therapist Update (Location or status change)
          (isOwner(existing().therapistId) && incoming().total == existing().total && 
           incoming().diff(existing()).affectedKeys().hasOnly(['state', 'liveLat', 'liveLng', 'updatedAt']) &&
           isValidStateTransition(existing().state, incoming().state)) ||
          // Action: Unassigned Booking Acceptance
          (existing().state == 'pendiente' && !('therapistId' in existing()) &&
           incoming().therapistId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['state', 'therapistId', 'therapistName', 'therapistPhoto', 'therapistPhone', 'acceptedAt', 'updatedAt']))
        ))
      );
      allow delete: if isAdmin();
    }
    
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && isValidId(invoiceId) && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /pagos/{pagoId} {
      allow get: if isSignedIn() && isValidId(pagoId) && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /alertas_panico/{alertaId} {
      allow get: if isValidId(alertaId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(alertaId) && isValidPanicAlert(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isValidId(alertaId) && (isAdmin() || (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['latitude', 'longitude', 'accuracy', 'updatedAt'])));
      allow delete: if isAdmin();
    }
  }
}
