rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // GLOBAL SECURITY HELPERS & RBAC DEFINITIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'essenya222@gmail.com' ||
          request.auth.token.email == 'admin.test.phase1@essenya.com' ||
          request.auth.token.email == 'admin@essenya.com'
        )) ||
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'administrador' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin'))
      );
    }
    
    // A registered therapist
    function isTherapist() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/terapeutas/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'terapeuta')
      );
    }
    
    // An ACTIVE therapist (Requirement 1)
    function isActiveTherapist() {
      return isTherapist() && 
             get(/databases/$(database)/documents/terapeutas/$(request.auth.uid)).data.estado == 'activo';
    }
    
    function isClient() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/clientes/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'cliente')
      );
    }
    
    // ==========================================
    // 1. ADMINISTRADORES & CONFIGURACIONES (ADMIN ONLY)
    // ==========================================
    match /administradores/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow create, update, delete: if isAdmin();
    }
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow create, update, delete: if isAdmin();
    }
    match /configuraciones/{configId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Requirement 8: Audit Logs cannot be spoofed.
      allow create: if isSignedIn() && (
        isAdmin() || 
        (!isAdmin() && 
         request.resource.data.actorId == request.auth.uid && // Must match actual UID
         !(request.resource.data.userRole in ['Administrador', 'Sistema / App', 'Sistema']) &&
         !(request.resource.data.role in ['Administrador', 'Sistema / App', 'Sistema'])
        )
      );
      allow update, delete: if false; // Immutable audit trail
    }

    // ==========================================
    // 2. MASTER USER PROFILES & IDENTITIES
    // ==========================================
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && 
                    (request.resource.data.rol in ['cliente', 'terapeuta'] || isAdmin()) &&
                    request.resource.data.uid == userId;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(userId) && request.resource.data.rol == resource.data.rol && request.resource.data.estado == resource.data.estado) // Cannot escalate role or status
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. CLIENT PROFILES
    // ==========================================
    match /clientes/{clienteId} {
      // Therapists can read to see their client's info when assigned.
      allow read: if isSignedIn() && (isOwner(clienteId) || isAdmin() || isTherapist());
      allow create: if isSignedIn() && (isOwner(clienteId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(clienteId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. THERAPIST PROFILES (PUBLIC & PRIVATE)
    // ==========================================
    
    // PUBLIC PROFILE (Requirement 3: strict separation)
    match /terapeutas_publicos/{terapeutaId} {
      allow read: if true; // Public for visitors
      allow write: if isAdmin() || isOwner(terapeutaId); // Updated by sync logic
    }
    
    // PRIVATE DOSSIER (Requirement 2 & 3)
    match /terapeutas/{terapeutaId} {
      // ONLY accessible by the therapist and admin
      allow read: if isSignedIn() && (isOwner(terapeutaId) || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() || 
        (
          isOwner(terapeutaId) && 
          !request.resource.data.keys().hasAny([
            'adminNotes', 'notasAdmin', 'notasAdministrativas',
            'approval', 'aprobacion', 'isApproved', 'aprobado',
            'bloqueos', 'permisos', 'puntuacionAdministrativa'
          ]) &&
          (!request.resource.data.keys().hasAny(['estado', 'status']) || 
           request.resource.data.estado == 'pendiente' || 
           request.resource.data.status == 'pendiente')
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        (
          isOwner(terapeutaId) && 
          // Strict field-level security:
          // 1. Therapists blocked from modifying their own status, approval, or adminNotes
          // 2. CURP and INE fields strictly restricted to admin roles
          // 3. Security, metrics, and role fields protected against tampering
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            // Status and approval fields (blocked for therapist)
            'status', 'estado', 
            'approval', 'aprobacion', 'isApproved', 'aprobado',
            // Administrative notes (blocked for therapist)
            'adminNotes', 'notasAdmin', 'notasAdministrativas', 'notas',
            // Official identity & document records (restricted to admin roles)
            'curp', 'CURP', 'curpUrl', 'documentoCurp',
            'ine', 'INE', 'ineNumber', 'ineUrl', 'documentoIne',
            // Core identity and role immutability
            'id', 'userId', 'uid', 'rol', 'role',
            'bloqueos', 'permisos', 'puntuacionAdministrativa', 
            'serviciosCompletados', 'documentos', 'verificado', 
            'motivoRechazoAccount', 'puntuacion'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. RESERVAS / APPOINTMENTS (STRICT ROLE ISOLATION)
    // ==========================================
    match /reservas/{reservaId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.clientId == request.auth.uid || 
        resource.data.therapistId == request.auth.uid ||
        // Requirement 1: Only ACTIVE therapists can see pending bookings queue
        (isActiveTherapist() && resource.data.state == 'pendiente')
      );
      
      // Requirement 6: Harden creation
      allow create: if isSignedIn() && (
        isAdmin() || 
        (isClient() && request.resource.data.clientId == request.auth.uid)
      );
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        
        // CLIENT RULES
        (
          resource.data.clientId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewComment', 'reviewedAt', 'state', 'cancellationReason', 'updatedAt']) &&
          (
            request.resource.data.state == resource.data.state || 
            (resource.data.state == 'pendiente' && request.resource.data.state == 'cancelado')
          )
        ) || 
        
        // ASSIGNED THERAPIST RULES (Must be ACTIVE to progress)
        (
          isActiveTherapist() &&
          resource.data.therapistId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'etaMinutes', 'liveLat', 'liveLng', 'updatedAt']) &&
          request.resource.data.state in ['aceptada', 'en_camino', 'llegue', 'servicio_iniciado', 'servicio_finalizado']
        ) ||
        
        // UNASSIGNED THERAPIST DISPATCH RULES (Requirement 1: Must be ACTIVE to accept)
        (
          isActiveTherapist() && 
          resource.data.state == 'pendiente' && 
          request.resource.data.state == 'aceptada' && 
          request.resource.data.therapistId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'therapistId', 'therapistName', 'therapistPhone', 'therapistPhoto', 'updatedAt'])
        )
      );
      
      allow delete: if isAdmin();
    }

    // ==========================================
    // 6. INVOICES & PAYMENTS (Requirement 7)
    // ==========================================
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow create: if isSignedIn() && (
        isAdmin() || 
        (request.resource.data.clientId == request.auth.uid &&
         !request.resource.data.keys().hasAny(['pago_confirmado', 'importe_cobrado', 'reembolso', 'paymentStatus']))
      );
      allow update, delete: if isAdmin();
    }
    match /pagos/{pagoId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow create: if isSignedIn() && (
        isAdmin() || 
        (request.resource.data.clientId == request.auth.uid &&
         !request.resource.data.keys().hasAny(['pago_confirmado', 'importe_cobrado', 'reembolso', 'paymentStatus']))
      );
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 7. CATALOGS
    // ==========================================
    match /servicios/{servicioId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /zonas/{zonaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /alertas_panico/{alertaId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
