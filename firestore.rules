rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // GLOBAL SECURITY HELPERS & RBAC DEFINITIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'administrador') ||
        ('rol' in request.auth.token && request.auth.token.rol == 'administrador') ||
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // A registered therapist
    function isTherapist() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/terapeutas/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'terapeuta')
      );
    }
    
    // An ACTIVE therapist
    function isActiveTherapist() {
      return isTherapist() && 
             get(/databases/$(database)/documents/terapeutas/$(request.auth.uid)).data.estado == 'activo';
    }
    
    function isClient() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/clientes/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'cliente')
      );
    }
    
    // ==========================================
    // 1. ADMINISTRADORES & CONFIGURACIONES (ADMIN ONLY)
    // ==========================================
    match /administradores/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow write: if isAdmin();
    }
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow write: if isAdmin();
    }
    match /configuraciones/{configId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; 
    }

    // ==========================================
    // 2. MASTER USER PROFILES & IDENTITIES
    // ==========================================
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && 
                    (request.resource.data.rol in ['cliente', 'terapeuta'] || isAdmin()) &&
                    request.resource.data.uid == userId &&
                    (isAdmin() || !request.resource.data.keys().hasAny(['role', 'admin', 'claims', 'permissions', 'nivelAcceso', 'estado', 'isActive', 'saldo', 'balance', 'membershipTier', 'rewardsPoints', 'spentTotal', 'membership']));
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(userId) && 
         request.resource.data.rol == resource.data.rol && 
         (!('estado' in resource.data) || request.resource.data.estado == resource.data.estado) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rol', 'admin', 'claims', 'permissions', 'nivelAcceso', 'estado', 'isActive', 'saldo', 'balance', 'membershipTier', 'rewardsPoints', 'spentTotal', 'membership'])
        )
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. CLIENT PROFILES
    // ==========================================
    match /clientes/{clienteId} {
      allow read: if isSignedIn() && (isOwner(clienteId) || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() || 
        (isOwner(clienteId) && !request.resource.data.keys().hasAny(['role', 'rol', 'admin', 'claims', 'permissions', 'nivelAcceso', 'estado', 'isActive', 'saldo', 'balance', 'membershipTier', 'rewardsPoints', 'spentTotal', 'membership', 'membresia']))
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(clienteId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rol', 'admin', 'claims', 'permissions', 'nivelAcceso', 'estado', 'isActive', 'saldo', 'balance', 'membershipTier', 'rewardsPoints', 'spentTotal', 'membership', 'membresia']))
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. THERAPIST PROFILES (PUBLIC & PRIVATE)
    // ==========================================
    
    // PUBLIC PROFILE: STRICT ALLOWLIST PROTECTION (Requirement 10)
    // Therapists can only edit approved presentation fields.
    // Critical metrics, status, IDs, ratings, financial and security fields strictly blocked.
    match /terapeutas_publicos/{terapeutaId} {
      allow read: if true; // Public catalog
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(terapeutaId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fotografia', 'foto', 'fotoPerfil',
          'biografia', 'bio', 'descripcion',
          'especialidades', 'disponibilidad', 'zonasCobertura',
          'telefono', 'updatedAt'
        ])
      );
    }
    
    // PRIVATE DOSSIER: Only therapist owner or admin
    match /terapeutas/{terapeutaId} {
      allow read: if isSignedIn() && (isOwner(terapeutaId) || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() || 
        (
          isOwner(terapeutaId) && 
          !request.resource.data.keys().hasAny([
            'adminNotes', 'notasAdmin', 'notasAdministrativas',
            'approval', 'aprobacion', 'isApproved', 'aprobado',
            'bloqueos', 'permisos', 'puntuacionAdministrativa',
            'puntuacion', 'rating', 'serviciosCompletados'
          ]) &&
          (!request.resource.data.keys().hasAny(['estado', 'status', 'estadoAprobacion']) || 
           request.resource.data.estado == 'pendiente' || 
           request.resource.data.status == 'pendiente' ||
           request.resource.data.estadoAprobacion == 'pendiente')
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        (
          isOwner(terapeutaId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'estado', 'estadoAprobacion', 'estadoVerificacion',
            'approval', 'aprobacion', 'isApproved', 'aprobado', 'verificado', 'isActive',
            'adminNotes', 'notasAdmin', 'notasAdministrativas', 'notas',
            'curp', 'CURP', 'curpUrl', 'documentoCurp',
            'ine', 'INE', 'ineNumber', 'ineUrl', 'documentoIne',
            'id', 'userId', 'uid', 'rol', 'role',
            'bloqueos', 'permisos', 'puntuacionAdministrativa', 
            'serviciosCompletados', 'totalServices',
            'motivoRechazoAccount', 'puntuacion', 'rating', 'reviewCount', 'resenasCount', 'numeroResenas',
            'fechaAprobacion', 'autorAprobacion'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. RESERVAS / APPOINTMENTS (STRICT ROLE ISOLATION)
    // ==========================================
    match /reservas/{reservaId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.clientId == request.auth.uid || 
        (isActiveTherapist() && resource.data.therapistId == request.auth.uid) ||
        (isActiveTherapist() && resource.data.state == 'pendiente')
      );
      
      // BOOKING CREATION IS EXCLUSIVELY HANDLED BY SECURE BACKEND ENDPOINT (Admin SDK)
      // Clients are explicitly blocked from creating bookings directly to prevent price/discount/payment manipulation.
      allow create: if isAdmin();
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        
        // CLIENT RULES: Cancellation allowed only if pending
        (
          resource.data.clientId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'cancellationReason', 'updatedAt']) && 
          resource.data.state == 'pendiente' && 
          request.resource.data.state == 'cancelado'
        ) || 
        
        // ASSIGNED THERAPIST RULES: Must be ACTIVE to progress states
        (
          isActiveTherapist() &&
          resource.data.therapistId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'etaMinutes', 'liveLat', 'liveLng', 'updatedAt']) &&
          (
            (resource.data.state == 'pendiente' && request.resource.data.state == 'aceptada') ||
            (resource.data.state == 'aceptada' && request.resource.data.state == 'en_camino') ||
            (resource.data.state == 'en_camino' && request.resource.data.state == 'llegue') ||
            (resource.data.state == 'llegue' && request.resource.data.state == 'servicio_iniciado') ||
            (resource.data.state == 'servicio_iniciado' && request.resource.data.state == 'servicio_finalizado') ||
            (resource.data.state == request.resource.data.state) // Allow updating location/eta without state change
          )
        ) ||
        
        // UNASSIGNED THERAPIST DISPATCH: Must be ACTIVE to accept
        (
          isActiveTherapist() && 
          resource.data.state == 'pendiente' && 
          request.resource.data.state == 'aceptada' && 
          request.resource.data.therapistId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'therapistId', 'therapistName', 'therapistPhone', 'therapistPhoto', 'updatedAt'])
        ) ||
        
        // UNASSIGNED THERAPIST REJECT
        (
          isActiveTherapist() && 
          resource.data.state == 'pendiente' && 
          request.resource.data.state == 'pendiente' && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejectedBy', 'updatedAt']) &&
          (request.auth.uid in request.resource.data.rejectedBy)
        )
      );
      
      allow delete: if isAdmin();
    }

    // ==========================================
    // 6. INVOICES & PAYMENTS
    // ==========================================
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow create: if isSignedIn() && (
        isAdmin() || 
        (request.resource.data.clientId == request.auth.uid &&
         !request.resource.data.keys().hasAny(['pago_confirmado', 'importe_cobrado', 'reembolso', 'paymentStatus']))
      );
      allow update, delete: if isAdmin();
    }
    match /pagos/{pagoId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow create: if isSignedIn() && (
        isAdmin() || 
        (request.resource.data.clientId == request.auth.uid &&
         !request.resource.data.keys().hasAny(['pago_confirmado', 'importe_cobrado', 'reembolso', 'paymentStatus']))
      );
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 7. CATALOGS
    // ==========================================
    match /servicios/{servicioId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /zonas/{zonaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /alertas_panico/{alertaId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
