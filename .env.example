# Google Maps API Key for routing and geolocation
GOOGLE_MAPS_PLATFORM_KEY=

# Server-Side Gemini API Key (Secret, never exposed to client)
GEMINI_API_KEY=

# Firebase Admin SDK Credentials (Required for Vercel / Production Deployment)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional Firebase Overrides for custom environments (Defaults to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
