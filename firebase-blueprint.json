{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Master identity record for all accounts (Client, Therapist, Admin)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "nombre": { "type": "string", "maxLength": 100 },
        "apellidos": { "type": "string", "maxLength": 100 },
        "correo": { "type": "string", "format": "email" },
        "telefono": { "type": "string", "maxLength": 20 },
        "rol": { "type": "string", "enum": ["cliente", "terapeuta", "administrador"] },
        "estado": { "type": "string", "enum": ["activo", "pendiente", "bloqueado"] },
        "fechaRegistro": { "type": "string", "format": "date-time" },
        "ultimoAcceso": { "type": "string", "format": "date-time" },
        "fechaActualizacion": { "type": "string", "format": "date-time" },
        "mustChangePassword": { "type": "boolean" }
      },
      "required": ["uid", "nombre", "correo", "rol", "estado"]
    },
    "ClientProfile": {
      "title": "Client Extended Profile",
      "description": "Additional data specific to high-end clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "membershipTier": { "type": "string", "enum": ["Gold", "Diamond", "Black"] },
        "address": { "type": "string" },
        "cityZone": { "type": "string" },
        "spentTotal": { "type": "number" },
        "totalBookings": { "type": "number" },
        "isBlocked": { "type": "boolean" },
        "specialNotes": { "type": "string" },
        "vipPreferences": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "email", "membershipTier"]
    },
    "TherapistProfile": {
      "title": "Therapist Extended Profile",
      "description": "Additional data specific to therapists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "nombre": { "type": "string" },
        "apellidos": { "type": "string" },
        "correo": { "type": "string" },
        "telefono": { "type": "string" },
        "estado": { "type": "string" },
        "especialidades": { "type": "array" },
        "zonasCobertura": { "type": "array" },
        "puntuacion": { "type": "number" },
        "resenasCount": { "type": "number" },
        "serviciosCompletados": { "type": "number" },
        "fechaAlta": { "type": "string", "format": "date-time" },
        "photo": { "type": "string" }
      },
      "required": ["id", "userId", "nombre", "correo", "estado"]
    },
    "Booking": {
      "title": "Booking/Reservation",
      "description": "Ritual reservation record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "therapistId": { "type": "string" },
        "therapistName": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "address": { "type": "string" },
        "cityZone": { "type": "string" },
        "total": { "type": "number" },
        "state": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "etaMinutes": { "type": "number" }
      },
      "required": ["id", "clientId", "clientName", "serviceId", "serviceName", "date", "time", "state"]
    },
    "PanicAlert": {
      "title": "Panic & Emergency SOS Alert",
      "description": "Real-time panic button activation with live geolocation update to admin portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string", "enum": ["cliente", "terapeuta", "client", "therapist"] },
        "bookingCode": { "type": "string" },
        "userLocation": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy": { "type": "number" },
        "status": { "type": "string", "enum": ["activa", "en_atencion", "resuelta"] },
        "emergencyType": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "resolvedBy": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userName", "status", "createdAt"]
    },
    "Administrator": {
      "title": "Administrator Profile",
      "description": "System administrator record verified in the administradores collection in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "correo": { "type": "string", "format": "email" },
        "nombre": { "type": "string" },
        "apellidos": { "type": "string" },
        "rol": { "type": "string", "enum": ["administrador", "admin"] },
        "estado": { "type": "string", "enum": ["activo", "inactivo", "bloqueado"] },
        "nivelAcceso": { "type": "string" },
        "fechaRegistro": { "type": "string", "format": "date-time" },
        "ultimoAcceso": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "correo", "nombre", "rol", "estado"]
    },
    "Service": {
      "title": "Service Catalog Item",
      "description": "Available rituals and treatments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "basePrice": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "basePrice"]
    },
    "Zone": {
      "title": "Coverage Zone",
      "description": "Geographic service area",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "surgeMultiplier": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "AuditLog": {
      "title": "System Audit Log",
      "description": "History of sensitive actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "userName", "timestamp"]
    },
    "GiftCard": {
      "title": "Gift Card",
      "description": "Client digital gift card voucher and credit balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "currentBalance": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "currentBalance", "status"]
    }
  },
  "firestore": {
    "administradores/{adminId}": {
      "schema": "Administrator",
      "description": "Authorized administrators with system-wide privileges"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Public and private user identity records"
    },
    "clientes/{clienteId}": {
      "schema": "ClientProfile",
      "description": "Detailed client data"
    },
    "clientes/{clienteId}/billetera/{cardId}": {
      "schema": "GiftCard",
      "description": "Client wallet balance gift cards and vouchers"
    },
    "terapeutas/{terapeutaId}": {
      "schema": "TherapistProfile",
      "description": "Detailed therapist data"
    },
    "reservas/{reservaId}": {
      "schema": "Booking",
      "description": "Appointment records"
    },
    "alertas_panico/{alertaId}": {
      "schema": "PanicAlert",
      "description": "Real-time emergency panic alerts and live geolocation updates streamed to admin portal"
    },
    "servicios/{servicioId}": {
      "schema": "Service",
      "description": "Rituals and services catalog"
    },
    "zonas/{zonaId}": {
      "schema": "Zone",
      "description": "Coverage zones"
    },
    "audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System event audit trail"
    }
  }
}
