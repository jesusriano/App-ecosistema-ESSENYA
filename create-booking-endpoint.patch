+// Booking creation endpoint
+app.post("/api/bookings", requireAuth, async (req: Request, res: Response) => {
+  try {
+    const { serviceId, date, time, preferences, clientAddress, cityZone } = req.body;
+    const uid = (req as any).user.uid;
+    const email = (req as any).user.email;
+    
+    const db = getAdminFirestore();
+    
+    // Get service official pricing
+    let price = 1800; // default if not found
+    let serviceName = "Servicio ESSENYA";
+    let durationMinutes = 90;
+    
+    if (serviceId) {
+      const srvDoc = await db.collection("servicios").doc(serviceId).get();
+      if (srvDoc.exists) {
+        const srvData = srvDoc.data();
+        price = srvData?.price || price;
+        serviceName = srvData?.name || serviceName;
+        durationMinutes = srvData?.durationMinutes || durationMinutes;
+      }
+    }
+
+    // Construct the booking document server-side
+    const newBooking = {
+      clientId: uid,
+      clientName: (req as any).user.name || email,
+      clientAddress: clientAddress || "",
+      cityZone: cityZone || "",
+      serviceId,
+      serviceName,
+      durationMinutes,
+      price: price,
+      total: price, // no discounts allowed by client
+      tip: 0,
+      date,
+      time,
+      preferences: preferences || {},
+      state: "pendiente",
+      paymentStatus: "pendiente", // enforced
+      createdAt: new Date().toISOString()
+    };
+
+    const bookingRef = await db.collection("reservas").add(newBooking);
+    
+    res.json({ success: true, bookingId: bookingRef.id, booking: { id: bookingRef.id, ...newBooking } });
+  } catch (err: any) {
+    res.status(500).json({ success: false, error: err.message });
+  }
+});
+
